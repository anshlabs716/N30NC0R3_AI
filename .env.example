# Copy to .env and adjust. Placeholder values only; never commit the real file.
# Local model server (Ollama); leave blank to use llama.cpp directly.
OLLAMA_HOST=http://127.0.0.1:11434
# Model to load (path or name), if not set on the command line.
NEON_MODEL=
# Optional web-search API endpoint / key. Leave blank to disable web search.
SEARCH_API_URL=
SEARCH_API_KEY=
